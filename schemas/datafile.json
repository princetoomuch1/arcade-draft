{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "datafile.json",
  "title": "A data/*.json file",
  "type": "object",
  "required": ["items"],
  "properties": {
    "generated": { "type": ["string", "null"], "format": "date-time" },
    "contract": { "type": "string" },
    "mock": { "type": "boolean" },
    "items": { "type": "array", "items": { "$ref": "feeditem.json" } }
  }
}
